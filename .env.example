# Copia este archivo como ".env" en el VPS y llena los valores reales.
# NUNCA subas el archivo ".env" real a git.

# --- Base de datos ---
POSTGRES_PASSWORD=cambia_esto_por_una_contrasena_larga_y_unica

# --- NextAuth ---
# Genera uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_tambien

# --- Zona horaria y localización ---
TZ=America/Mexico_City

# --- Recordatorios automáticos (cron + Telegram) ---
# Genera uno nuevo con: openssl rand -hex 16
# Protege el endpoint que dispara los recordatorios diarios — sin este
# secreto correcto, cualquiera podría llamarlo y gastar tus mensajes.
CRON_SECRET=cambia_esto_por_un_valor_al_azar
